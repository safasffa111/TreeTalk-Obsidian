{
  "name": "treetalk",
  "version": "0.9.4",
  "description": "Branching AI conversations and deliberate knowledge capture for Obsidian.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Len_shan",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest",
    "verify": "npm run test -- --run && npm run typecheck && npm run lint && npm run build",
    "regression": "node --test regression/*.node.test.mjs",
    "benchmark:pi-progressive": "node scripts/summarize-pi-progressive-benchmark.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "^10.0.1",
    "@types/d3-force": "3.0.10",
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
